# GitLab base URL, e.g. https://gitlab.company.com
GITLAB_URL="https://gitlab.example.com"

# GitLab Personal Access Token or Project Access Token.
# Required API scope: api
GITLAB_TOKEN="glpat-REPLACE_ME"

# Local git remote
GIT_REMOTE="origin"

# Must remain in this order for this tool.
BRANCH_FLOW="develop staging demo_pkg uat main"

# Prefix for generated branches
REVERT_BRANCH_PREFIX="revert"

# Safety: start with true. Set false only when ready to mutate.
DRY_RUN=true

# This implementation creates a GitLab MR for every reverted branch.
CREATE_MR=true
